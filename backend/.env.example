SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
CORS_ORIGINS=["http://localhost:5173"]
# Login and project import need no service-role or AI provider secrets.

# Phase 3: enter fresh keys locally; never commit backend/.env.
GEMINI_API_KEY=
GROQ_API_KEY=
# Choose a currently available function-calling text model in your provider console.
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_ENABLED=false
# Set true only after confirming all enabled providers/models use your free tier.
# This flag is operator confirmation, not an API billing check or spending cap.
AI_FREE_TIER_CONFIRMED=false
